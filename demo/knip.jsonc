{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "api/index.ts", // Vercel serverless entry (vercel.json), not inferable from a package script
    "eslint-plugin-agentproofarch/index.js", // loaded by eslint.config.js
    "eslint-plugin-agentproofarch/rules/*.test.js", // rule unit tests (vitest node project)
    "adapters/auth/auth.generate.ts", // @better-auth/cli generate config: codegen only, never imported
    "scripts/*.{ts,mjs}", // each script runs via a package script or by hand
    "e2e/*.spec.ts", // Playwright specs
    "visual/*.spec.ts", // Playwright visual-regression specs (ADR-0008)
    "**/*.test.{ts,tsx}", // vitest suites (the config uses nested projects the plugin can't fully infer)
    "apps/web/src/features/*/core/index.ts", // island-core seam: events in, selectors out (architecture.md §Client application state, ADR-0005)
    "apps/web/src/features/*/index.web.ts" // the ONE web composition site views import from
  ],
  "project": [
    "core/**/*.ts",
    "adapters/**/*.ts",
    "apps/**/*.{ts,tsx}",
    "api/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "eslint-plugin-agentproofarch/**/*.js",
    "config-regression/**/*.ts"
  ],
  "tags": ["-@public"], // `@public` marks a deliberately shipped surface; everything else must be reachable
  "ignoreDependencies": [
    // Peer of the @opentelemetry/sdk-trace-* packages, pinned in devDependencies
    // for version alignment across the OTel graph; never imported directly.
    "@opentelemetry/core"
  ],
  "ignoreBinaries": [
    // System binary (psmisc) the e2e harness shells out to free a stuck port on
    // Linux CI; not a package dependency, so knip cannot resolve it.
    "fuser",
    // `scripts/release.ts` cuts the docs snapshot with `pnpm --dir ../website
    // run docusaurus`; the binary belongs to website/'s own manifest, which is
    // outside this knip project.
    "docusaurus"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "duplicates": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error"
  }
}
